# Copy this file to .env and fill in your values.
# Never commit .env — it contains secret API keys.

# Port the Express server listens on
PORT=3001

# --- Image generation provider ---
# Which provider to use. Supported: openai | placeholder
# Leave blank or set to "placeholder" to return a dark SVG (no API key needed).
IMAGE_PROVIDER=openai

# API key for the selected provider.
# For OpenAI: your sk-... key from https://platform.openai.com/api-keys
IMAGE_API_KEY=

# Model to use for image generation.
# For OpenAI: gpt-image-1 (default) or dall-e-3
IMAGE_MODEL=gpt-image-1

# Base URL override — not used for OpenAI (the SDK handles it).
# Useful for other providers: Replicate, Stability AI, fal.ai, etc.
IMAGE_API_URL=

# --- Access protection ---
# If set, every request to /api/images/generate must include the header:
#   x-app-access-key: <your-key>
# The frontend will prompt you for this key once and store it in localStorage.
# Leave blank to disable access key protection (local dev only).
APP_ACCESS_KEY=

# --- Rate limiting ---
# Max image generation requests per IP within the time window.
# Defaults: 5 requests per 60 minutes.
IMAGE_RATE_LIMIT_WINDOW_MINUTES=60
IMAGE_RATE_LIMIT_MAX=5
