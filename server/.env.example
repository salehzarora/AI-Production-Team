# Copy this file to .env and fill in your values.
# Never commit .env — it contains secret API keys.

# Port the Express server listens on
PORT=3001

# --- Image generation provider ---
# Set these to connect a real image generation API.
# Supported providers: Replicate, Stability AI, fal.ai, OpenAI DALL-E 3, etc.
# Leave blank to run in placeholder mode (returns a grey SVG — useful for local UI testing).

IMAGE_API_KEY=
IMAGE_API_URL=
