# Copy this file to .env and fill in your values.
# Never commit .env — it contains secret API keys.

# Port the Express server listens on
PORT=3001

# --- Access protection ---
# If set, every request to /api/images/generate must include the header:
#   x-app-access-key: <your-key>
# The frontend will prompt you for this key once and store it in localStorage.
# Leave blank to disable access key protection (local dev only).
APP_ACCESS_KEY=

# --- Rate limiting ---
# Max image generation requests per IP within the time window.
# Defaults: 5 requests per 60 minutes.
IMAGE_RATE_LIMIT_WINDOW_MINUTES=60
IMAGE_RATE_LIMIT_MAX=5

# --- Image generation provider ---
# Set these to connect a real image generation API.
# Supported providers: Replicate, Stability AI, fal.ai, OpenAI DALL-E 3, etc.
# Leave blank to run in placeholder mode (returns a dark SVG — useful for UI testing).
IMAGE_API_KEY=
IMAGE_API_URL=
